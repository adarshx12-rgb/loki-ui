# Copy to .env (git-ignored) and adjust. Never commit real secrets.
# The server loads .env from the repository root on startup.

# ---- branding / network ----
NODEPILOT_APP_NAME=NodePilot
# Loopback only by default. Binding elsewhere requires NODEPILOT_ALLOW_NON_LOOPBACK=1 (not recommended).
NODEPILOT_HOST=127.0.0.1
NODEPILOT_PORT=4317
# Vite dev server port (dev mode only)
NODEPILOT_WEB_PORT=5173
# Extra allowed browser origins / Host headers (comma separated), e.g. for a webhook tunnel host.
NODEPILOT_ALLOWED_ORIGINS=
NODEPILOT_ALLOWED_HOSTS=

# Browser pairing code (off for now). 1 = browsers must enter a one-time code printed by the server.
NODEPILOT_REQUIRE_PAIRING=0

# ---- storage ----
# SQLite database, MCP token and file-sync state live here (default: <repo>/.data)
NODEPILOT_DATA_DIR=
# Pre-approved project roots (comma or semicolon separated absolute paths). More can be added in the UI.
NODEPILOT_APPROVED_ROOTS=

# ---- execution & retention ----
NODEPILOT_CONCURRENCY=4
NODEPILOT_RUNS_PER_WORKFLOW=100
NODEPILOT_TELEMETRY_MAX_EVENTS=20000
NODEPILOT_TELEMETRY_DAYS=7

# ---- model credentials (referenced from nodes as env:ANTHROPIC_API_KEY; optional) ----
ANTHROPIC_API_KEY=

# ---- GitHub App (optional; read-only). See docs/GITHUB.md ----
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
